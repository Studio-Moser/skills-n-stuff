#!/bin/bash
# transcribe — Fetch a spoken-word transcript from a video URL.
#
# Usage:
#   transcribe <url>           # markdown output
#   transcribe <url> --json    # JSON output
#
# Env:
#   WHISPER_MODEL    mlx-whisper model (default: mlx-community/whisper-large-v3-mlx)
#   HF_TOKEN         HuggingFace token, raises HF download rate limits
#   FORCE_WHISPER    if "1", skip YouTube-caption tier 0 and go straight to audio+whisper

set -euo pipefail

# ── Parse args ───────────────────────────────────────────────────────────────

URL=""
OUTPUT_JSON=false
FORCE_WHISPER="${FORCE_WHISPER:-0}"

for arg in "$@"; do
  case "$arg" in
    --json) OUTPUT_JSON=true ;;
    --force-whisper) FORCE_WHISPER=1 ;;
    -h|--help)
      cat <<'HELP'
transcribe — fetch a spoken-word transcript from a video URL.

Usage:
  transcribe <url>                  Markdown output (default)
  transcribe <url> --json           JSON output
  transcribe <url> --force-whisper  Skip YouTube captions, always run whisper

For YouTube URLs, tier 0 fetches auto-generated captions directly (fast,
no model download, no audio processing). Falls through to audio+whisper
if captions are unavailable or --force-whisper is set.

Supports: YouTube, YouTube Shorts, Instagram posts/Reels, TikTok, Threads.

Env:
  WHISPER_MODEL   mlx-whisper model (default: mlx-community/whisper-large-v3-mlx)
  HF_TOKEN        HuggingFace token for higher download rate limits
  FORCE_WHISPER   if "1", same as --force-whisper
HELP
      exit 0 ;;
    -*) echo "Unknown flag: $arg" >&2; exit 1 ;;
    *)  URL="$arg" ;;
  esac
done

if [[ -z "$URL" ]]; then
  echo "Usage: transcribe <url> [--json]" >&2
  exit 1
fi

# ── Locate plugin scripts ────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# ── Verify deps ──────────────────────────────────────────────────────────────

"$PLUGIN_ROOT/scripts/verify-deps.sh" >/dev/null 2>&1 || {
  echo "ERROR: transcribe plugin deps missing." >&2
  echo "Run: bash $PLUGIN_ROOT/scripts/install.sh" >&2
  exit 1
}

# ── Resolve a working yt-dlp ──────────────────────────────────────────────────
# Homebrew ships yt-dlp as a Python script whose shebang pins an exact
# interpreter path. A Homebrew Python point-release bump (e.g. 3.13 → 3.14)
# deletes that path and silently breaks the bare `yt-dlp` command with a
# "bad interpreter" error. Probe it once; on failure fall back to a
# Python-managed invocation (`uvx yt-dlp`, then `python3 -m yt_dlp`) that
# Homebrew's interpreter churn can't break. YTDLP is an argv array — always
# expand it as "${YTDLP[@]}".

if yt-dlp --version >/dev/null 2>&1; then
  YTDLP=(yt-dlp)
elif command -v uvx >/dev/null 2>&1; then
  echo "→ bare yt-dlp not runnable; falling back to 'uvx yt-dlp'" >&2
  YTDLP=(uvx yt-dlp)
elif python3 -c 'import yt_dlp' >/dev/null 2>&1; then
  echo "→ bare yt-dlp not runnable; falling back to 'python3 -m yt_dlp'" >&2
  YTDLP=(python3 -m yt_dlp)
else
  echo "→ WARNING: no runnable yt-dlp found (bare / uvx / python3 -m yt_dlp all failed)" >&2
  YTDLP=(yt-dlp)
fi

# ── Detect platform ──────────────────────────────────────────────────────────

detect_platform() {
  local url="$1"
  if   [[ "$url" =~ (youtube\.com|youtu\.be) ]]; then echo "YouTube"
  elif [[ "$url" =~ instagram\.com ]];          then echo "Instagram"
  elif [[ "$url" =~ tiktok\.com ]];             then echo "TikTok"
  elif [[ "$url" =~ threads\.(net|com) ]];      then echo "Threads"
  else                                               echo "Unknown"
  fi
}

PLATFORM="$(detect_platform "$URL")"
echo "Platform: $PLATFORM" >&2

# ── Temp dir ─────────────────────────────────────────────────────────────────

TMPDIR_WORK="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_WORK"' EXIT
AUDIO_WAV="$TMPDIR_WORK/audio_16k.wav"

# ── Tier 0: YouTube captions (YouTube only) ──────────────────────────────────

WHISPER_MODEL="${WHISPER_MODEL:-mlx-community/whisper-large-v3-mlx}"
VIDEO_TITLE="Unknown"
DURATION_SECONDS=0
USED_TIER=""
CAPTION_TEXT=""
CAPTION_KIND=""  # "manual" or "auto" when tier 0 succeeds

tier0_youtube_captions() {
  echo "→ Tier 0: YouTube captions" >&2

  # Fetch title + duration and attempt caption download in one pass.
  # Prefer manual subs; fall back to auto-generated.
  local meta
  meta="$("${YTDLP[@]}" --print "%(title)s|||%(duration)s" "$URL" 2>/dev/null || true)"
  if [[ -n "$meta" ]]; then
    VIDEO_TITLE="${meta%%|||*}"
    DURATION_SECONDS="${meta##*|||}"
    [[ "$DURATION_SECONDS" == "NA" || -z "$DURATION_SECONDS" ]] && DURATION_SECONDS=0
  fi

  "${YTDLP[@]}" --skip-download \
         --write-sub --write-auto-sub \
         --sub-lang "en.*,en-orig" \
         --sub-format vtt \
         -o "$TMPDIR_WORK/caps.%(ext)s" \
         "$URL" >/dev/null 2>&1 || return 1

  # Prefer manual subs (caps.en.vtt) over auto (caps.en-*.vtt, caps.en-orig.vtt).
  local vtt
  vtt="$(ls "$TMPDIR_WORK"/caps.en.vtt 2>/dev/null | head -1)"
  if [[ -n "$vtt" ]]; then
    CAPTION_KIND="manual"
  else
    vtt="$(ls "$TMPDIR_WORK"/caps.en*.vtt 2>/dev/null | head -1)"
    [[ -n "$vtt" ]] && CAPTION_KIND="auto"
  fi
  [[ -z "$vtt" ]] && return 1

  # Parse VTT → plain text. Strips cue timestamps, WEBVTT header, cue ids,
  # inline <c> tags, and collapses YouTube's rolling-window duplication.
  local parsed_txt="$TMPDIR_WORK/captions.txt"
  VTT_PATH="$vtt" OUT_PATH="$parsed_txt" python3 "$PLUGIN_ROOT/scripts/parse-vtt.py" || return 1
  [[ ! -s "$parsed_txt" ]] && return 1
  CAPTION_TEXT="$(cat "$parsed_txt")"
  [[ -z "$CAPTION_TEXT" ]] && return 1
  USED_TIER="youtube-captions-$CAPTION_KIND"
  return 0
}

# ── Tier 1: yt-dlp ───────────────────────────────────────────────────────────

tier1_ytdlp() {
  echo "→ Tier 1: yt-dlp" >&2

  # Title + duration via yt-dlp metadata (may fail on some URLs; tolerate)
  local meta
  meta="$("${YTDLP[@]}" --print "%(title)s|||%(duration)s" "$URL" 2>/dev/null || true)"
  if [[ -n "$meta" ]]; then
    VIDEO_TITLE="${meta%%|||*}"
    DURATION_SECONDS="${meta##*|||}"
    [[ "$DURATION_SECONDS" == "NA" || -z "$DURATION_SECONDS" ]] && DURATION_SECONDS=0
  fi

  # Download + extract audio
  if ! "${YTDLP[@]}" -x --audio-format wav \
        -o "$TMPDIR_WORK/audio_raw.%(ext)s" \
        "$URL" >/dev/null 2>&1; then
    return 1
  fi

  local raw
  raw="$(find "$TMPDIR_WORK" -name 'audio_raw.*' -type f | head -1)"
  [[ -z "$raw" ]] && return 1

  ffmpeg -y -i "$raw" -ar 16000 -ac 1 -c:a pcm_s16le "$AUDIO_WAV" >/dev/null 2>&1 || return 1

  USED_TIER="ytdlp"
  return 0
}

# ── Skip tier 1 for known-unsupported platforms ──────────────────────────────

tier2_playwright() {
  echo "→ Tier 2: Playwright" >&2
  local meta
  meta="$(node "$PLUGIN_ROOT/scripts/extract-via-playwright.mjs" "$URL" "$TMPDIR_WORK" 2>&2)" || return 1
  [[ -z "$meta" ]] && return 1
  local vid_path
  vid_path="$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['video_path'])" "$meta" 2>/dev/null)" || return 1
  VIDEO_TITLE="$(python3 -c "import json,sys; print(json.loads(sys.argv[1])['title'])" "$meta" 2>/dev/null)" || VIDEO_TITLE="Unknown"
  # Playwright path doesn't give duration reliably; probe with ffprobe.
  DURATION_SECONDS="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$vid_path" 2>/dev/null | cut -d. -f1 || echo 0)"
  [[ -z "$DURATION_SECONDS" ]] && DURATION_SECONDS=0
  ffmpeg -y -i "$vid_path" -ar 16000 -ac 1 -c:a pcm_s16le "$AUDIO_WAV" >/dev/null 2>&1 || return 1
  USED_TIER="playwright"
  return 0
}

if [[ "$PLATFORM" == "YouTube" && "$FORCE_WHISPER" != "1" ]] && tier0_youtube_captions; then
  :
elif [[ "$PLATFORM" == "Threads" ]]; then
  echo "→ Tier 1 skipped (Threads unsupported by yt-dlp)" >&2
  tier2_playwright || { echo "ERROR: tier 2 extraction failed for $URL" >&2; exit 2; }
elif tier1_ytdlp; then
  :
else
  echo "→ Tier 1 failed, falling through to tier 2" >&2
  tier2_playwright || { echo "ERROR: both tiers failed for $URL" >&2; exit 2; }
fi

# ── Transcribe with mlx-whisper (skipped if tier 0 provided captions) ────────

TRANSCRIPT_JSON=""
if [[ -n "$CAPTION_TEXT" ]]; then
  echo "→ Using YouTube $CAPTION_KIND captions (skipped whisper)" >&2
  TRANSCRIPT_TEXT="$CAPTION_TEXT"
else
  echo "→ Transcribing with $WHISPER_MODEL" >&2
  TRANSCRIPT_JSON="$TMPDIR_WORK/transcript.json"
  python3 - <<PYEOF > "$TRANSCRIPT_JSON"
import json, mlx_whisper
r = mlx_whisper.transcribe("$AUDIO_WAV", path_or_hf_repo="$WHISPER_MODEL")
print(json.dumps(r))
PYEOF
  TRANSCRIPT_TEXT="$(python3 -c "import json,sys; print(json.load(open('$TRANSCRIPT_JSON'))['text'].strip())")"
fi

# ── Format output ────────────────────────────────────────────────────────────

human_duration() {
  local s="${1:-0}"
  [[ "$s" == "0" ]] && { echo "unknown"; return; }
  printf "%d:%02d" $((s/60)) $((s%60))
}

MODEL_LABEL="$WHISPER_MODEL"
if [[ -n "$CAPTION_TEXT" ]]; then
  MODEL_LABEL="youtube-$CAPTION_KIND-captions"
fi

if $OUTPUT_JSON; then
  TRANSCRIPT_JSON_ARG="${TRANSCRIPT_JSON:-}" \
  TRANSCRIPT_TEXT_ARG="$TRANSCRIPT_TEXT" \
  VIDEO_TITLE_ARG="$VIDEO_TITLE" URL_ARG="$URL" PLATFORM_ARG="$PLATFORM" \
  DURATION_ARG="$DURATION_SECONDS" MODEL_ARG="$MODEL_LABEL" TIER_ARG="$USED_TIER" \
  python3 - <<'PYEOF'
import json, os
tj = os.environ["TRANSCRIPT_JSON_ARG"]
text = os.environ["TRANSCRIPT_TEXT_ARG"].strip()
segments = []
if tj:
    data = json.load(open(tj))
    text = data.get("text", "").strip() or text
    segments = [
        {"start": s["start"], "end": s["end"], "text": s["text"].strip()}
        for s in data.get("segments", [])
    ]
out = {
    "title": os.environ["VIDEO_TITLE_ARG"],
    "url": os.environ["URL_ARG"],
    "platform": os.environ["PLATFORM_ARG"],
    "duration_seconds": int(os.environ["DURATION_ARG"] or 0),
    "model": os.environ["MODEL_ARG"],
    "tier": os.environ["TIER_ARG"],
    "text": text,
    "segments": segments,
}
print(json.dumps(out, indent=2))
PYEOF
else
  cat <<MD
# $VIDEO_TITLE

**Source:** $URL
**Platform:** $PLATFORM
**Duration:** $(human_duration "$DURATION_SECONDS")
**Model:** $MODEL_LABEL

$TRANSCRIPT_TEXT
MD
fi
