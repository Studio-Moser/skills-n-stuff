#!/bin/sh
# Start a command (usually an MCP server) with named secrets from this machine's
# secret store, so no agent config ever holds a secret value.
#
#   with-secrets NAME [NAME ...] -- command [args...]
#
# Written by harness:sync from plugins/harness/templates/with-secrets; edit it there.
h="${HARNESS_ROOT:-}"
if [ -z "$h" ]; then
  h=$(ls -d "$HOME"/.claude/plugins/cache/*/harness/*/ "$HOME"/.codex/plugins/cache/*/harness/*/ 2>/dev/null \
    | awk -F/ '{print $(NF-1)"\t"$0}' | sort -V | tail -1 | cut -f2)
fi
[ -n "$h" ] || { echo "with-secrets: Harness plugin not found under ~/.claude or ~/.codex" >&2; exit 78; }
envs=""
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  envs="$envs --env $1"
  shift
done
[ "${1:-}" = "--" ] || { echo "usage: with-secrets NAME [NAME ...] -- command [args...]" >&2; exit 2; }
shift
# agent-secrets validates each NAME, so the unquoted $envs splits only on its own spaces.
exec python3 "${h%/}/scripts/agent-secrets.py" exec $envs -- "$@"
