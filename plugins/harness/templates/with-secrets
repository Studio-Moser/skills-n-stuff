#!/bin/sh
# Start a command (usually an MCP server) with named secrets from this machine's
# secret store, so no agent config ever holds a secret value.
#
#   with-secrets NAME [NAME ...] -- command [args...]
#
# Self-contained on purpose: it runs on every MCP server start, whatever Harness
# version is installed. Reads the same stores as scripts/agent-secrets.py (which
# also sets, checks, and copies them): HARNESS_SECRETS_BACKEND, else the macOS
# Keychain, the Linux keyring via secret-tool, or ~/.config/agent-secrets/secrets.env.
# A name already set in the environment is kept. Values never reach a command line.
#
# Written by harness:sync from plugins/harness/templates/with-secrets; edit it there.
service="${HARNESS_SECRETS_SERVICE:-agent-secrets}"
backend="${HARNESS_SECRETS_BACKEND:-}"
if [ -z "$backend" ]; then
  if [ "$(uname -s)" = Darwin ] && command -v security >/dev/null 2>&1; then backend=keychain
  elif command -v secret-tool >/dev/null 2>&1; then backend=libsecret
  else backend=file
  fi
fi
store="${XDG_CONFIG_HOME:-$HOME/.config}/agent-secrets/secrets.env"

lookup() {
  case "$backend" in
    keychain) security find-generic-password -s "$service" -a "$1" -w ${HARNESS_KEYCHAIN:+"$HARNESS_KEYCHAIN"} 2>/dev/null ;;
    libsecret) secret-tool lookup service "$service" account "$1" 2>/dev/null ;;
    *) [ -f "$store" ] && sed -n "s/^$1=//p" "$store" | head -n 1 ;;
  esac
}

usage() { echo "usage: with-secrets NAME [NAME ...] -- command [args...]" >&2; exit 2; }
separated=""
for arg in "$@"; do [ "$arg" = "--" ] && { separated=1; break; }; done
[ -n "$separated" ] || usage

while [ "$1" != "--" ]; do
  name="$1"
  shift
  case "$name" in
    *[!A-Za-z0-9_]* | [0-9]* | "") echo "with-secrets: invalid secret name '$name'" >&2; exit 2 ;;
  esac
  eval "current=\${$name:-}"
  [ -n "$current" ] && continue
  value="$(lookup "$name")"
  if [ -z "$value" ]; then
    echo "with-secrets: $name is not stored on this machine; run: agent-secrets.py set $name" >&2
    exit 78
  fi
  export "$name=$value"
done
shift
[ $# -gt 0 ] || usage
exec "$@"
