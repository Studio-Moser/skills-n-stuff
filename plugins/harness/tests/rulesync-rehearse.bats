#!/usr/bin/env bats

setup() {
  REHEARSE="$(cd "${BATS_TEST_DIRNAME}/../scripts" && pwd)/rulesync-rehearse.py"
  export HOME="$BATS_TEST_TMPDIR/home"
  REPO="$BATS_TEST_TMPDIR/agents"
  BIN="$BATS_TEST_TMPDIR/bin"
  mkdir -p "$HOME/.codex" "$REPO/.rulesync/rules" "$BIN"
  printf '{ "global": true }\n' > "$REPO/rulesync.jsonc"
  printf -- '---\nroot: true\n---\nRule\n' > "$REPO/.rulesync/rules/Global_Instructions.md"
  printf 'live\n' > "$HOME/.codex/AGENTS.md"
  # Stub npx: the dry run lists one file; a real generate appends a line naming the
  # version, or (STUB_SAME=1) a fixed line, to the seeded copy of that file.
  cat > "$BIN/npx" <<'EOF'
#!/bin/sh
version="${2#rulesync@}"
case "$*" in
  *--dry-run*) echo "[DRY RUN] Would write: $HOME/.codex/AGENTS.md" ;;
  *) if [ -n "${STUB_SAME:-}" ]; then echo "generated" >> "$HOME/.codex/AGENTS.md"; else echo "generated by $version" >> "$HOME/.codex/AGENTS.md"; fi ;;
esac
EOF
  chmod +x "$BIN/npx"
  export PATH="$BIN:$PATH"
}

@test "identical output from both versions passes" {
  run env STUB_SAME=1 "$REHEARSE" 99.0.0 "$REPO"
  [ "$status" -eq 0 ]
  [[ "$output" == *"1 file(s) compared between rulesync@39.0.0 and rulesync@99.0.0"* ]] || return 1
  [[ "$output" == *"REHEARSAL=identical" ]]
}

@test "differences are shown as a diff and the live file is never touched" {
  run "$REHEARSE" rulesync@99.0.0 "$REPO"
  [ "$status" -eq 1 ]
  [[ "$output" == *"differs: ~/.codex/AGENTS.md"* ]] || return 1
  [[ "$output" == *"-generated by 39.0.0"* ]] || return 1
  [[ "$output" == *"+generated by 99.0.0"* ]] || return 1
  [[ "$output" == *"REHEARSAL=1 file(s) differ" ]] || return 1
  [ "$(cat "$HOME/.codex/AGENTS.md")" = "live" ]
}

@test "an unmanaged repo is refused" {
  rm "$REPO/rulesync.jsonc"
  run "$REHEARSE" 99.0.0 "$REPO"
  [ "$status" -eq 2 ]
  [[ "$output" == "REHEARSAL=skipped:"* ]]
}
