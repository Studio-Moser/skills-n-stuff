{
  "description": "Harness environment shims. Each one is cataloged in Component_Catalog.toml and logs its firings to Harness telemetry.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/zsh-glob-guard.py\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
